<?xml version="1.0" encoding="utf-8"?>
<!--
  ClinicCare - Web.config
  Weeks 1-4 : database, CRUD, navigation, booking flow
  Weeks 5-6 : validation, membership & security, SMTP mail, export
-->
<configuration>

  <connectionStrings>
    <!--
      Local development connection (SQL Server Express, mixed-mode SQL auth).
      The local instance on this machine is SQLEXP2017; change the instance name
      if yours differs (e.g. .\SQLEXPRESS).
      The ASP.NET membership tables live in this same database, installed with
      aspnet_regsql.exe -S .\SQLEXP2017 -E -d ClinicDB -A all
      TODO: replace with the SmarterASP.net connection string before deployment.
    -->
    <add name="ClinicDBConnection"
         connectionString="Data Source=.\SQLEXP2017;Initial Catalog=ClinicDB;User ID=cliniccare_app;Password=__REDACTED__;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="ClinicName" value="ClinicCare - Mohammed Jasim Hassan Almarzooq" />
    <add key="ClinicPhone" value="011 288 9999" />
    <add key="GridPageSize" value="10" />

    <!-- Address the confirmation emails are sent "from" / replies go to. -->
    <add key="ClinicFromEmail" value="mohammedalmarzooq06@gmail.com" />
    <add key="ClinicFromName" value="ClinicCare Appointments" />
    <!-- Set to false to disable outbound mail entirely (useful when demoing offline). -->
    <add key="EmailEnabled" value="true" />

    <!--
      .NET 4.5 changed the default to UnobtrusiveValidationMode="WebForms", which
      makes every page containing a validator throw:
        "WebForms UnobtrusiveValidationMode requires a ScriptResourceMapping for
         'jquery'. Please add a ScriptResourceMapping named jquery."
      Setting it to None restores the classic inline validation script. The
      alternative is registering a jQuery ScriptResourceMapping in
      Application_Start, which would tie validation to a specific jQuery build.
    -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />

    <!--
      Folder that Admin/Backup.aspx writes .bak files to. This path is resolved
      by the SQL SERVER SERVICE, not by the web application, so it must exist on
      the database server and the service account needs modify permission on it.
      On shared hosting the database is usually on a separate machine, in which
      case use the host's own control-panel backup tool instead.
    -->
    <add key="BackupFolder" value="c:\Users\hjasi\Desktop\COOP\Project\db\backups" />
  </appSettings>

  <!-- ======================================================================
       SMTP - Gmail (rubric ID 3)

       THIS SECTION IS ENCRYPTED. The host, port, username and Gmail App
       Password are protected with the RsaProtectedConfigurationProvider, so the
       credentials are not readable in this file. ASP.NET decrypts the section
       transparently at runtime - no code change is needed to read it.

       PREREQUISITE (done manually in the Google account, not in code):
         1. Enable 2-Step Verification on the Gmail account
         2. Go to myaccount.google.com/apppasswords  (this page is NOT listed
            under "How you sign in to Google" - reach it by URL or search)
         3. Generate the 16-character App Password. It is displayed in four
            groups of four; the spaces are formatting and must be removed.
       Gmail rejects the normal account password - only an App Password works.

       To edit the settings again:
         aspnet_regiis -pdf "system.net/mailSettings/smtp" "<this folder>"   (decrypt)
         ...edit the values...
         aspnet_regiis -pef "system.net/mailSettings/smtp" "<this folder>"   (re-encrypt)

       IMPORTANT - the RSA key is machine-specific. This encrypted section will
       NOT decrypt on the SmarterASP.net server. Before deploying, either export
       and import the key container, or decrypt, deploy, and re-encrypt there.
       ====================================================================== -->
  <system.net>
    <mailSettings>
      <smtp configProtectionProvider="RsaProtectedConfigurationProvider">
          <EncryptedData Type="http://www.w3.org/2001/04/xmlenc#Element"
              xmlns="http://www.w3.org/2001/04/xmlenc#">
              <EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#aes256-cbc" />
              <KeyInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
                  <EncryptedKey xmlns="http://www.w3.org/2001/04/xmlenc#">
                      <EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#rsa-oaep-mgf1p" />
                      <KeyInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
                          <KeyName>Rsa Key</KeyName>
                      </KeyInfo>
                      <CipherData>
                          <CipherValue></CipherValue>
                      </CipherData>
                  </EncryptedKey>
              </KeyInfo>
              <CipherData>
                  <CipherValue></CipherValue>
              </CipherData>
          </EncryptedData>
      </smtp>
    </mailSettings>
  </system.net>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" requestValidationMode="4.5" />

    <customErrors mode="RemoteOnly" defaultRedirect="~/Default.aspx" />

    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID">
      <namespaces>
        <add namespace="ClinicCare.Models" />
        <add namespace="ClinicCare.DataAccess" />
      </namespaces>
    </pages>

    <sessionState mode="InProc" timeout="30" />

    <!-- ================= Forms authentication (rubric ID 5) ================= -->
    <authentication mode="Forms">
      <forms name=".ClinicCareAuth"
             loginUrl="~/Login.aspx"
             defaultUrl="~/Default.aspx"
             protection="All"
             timeout="60"
             slidingExpiration="true"
             cookieless="UseCookies" />
    </authentication>

    <!-- Deny by default: anonymous users are refused everywhere, and the
         <location> blocks at the bottom of this file re-open the public pages.
         New pages are therefore protected unless deliberately made public. -->
    <authorization>
      <deny users="?" />
    </authorization>

    <!-- ================= Membership at the database level ================= -->
    <membership defaultProvider="ClinicSqlMembershipProvider">
      <providers>
        <clear />
        <add name="ClinicSqlMembershipProvider"
             type="System.Web.Security.SqlMembershipProvider"
             connectionStringName="ClinicDBConnection"
             applicationName="/ClinicCare"
             enablePasswordRetrieval="false"
             enablePasswordReset="true"
             requiresQuestionAndAnswer="false"
             requiresUniqueEmail="true"
             passwordFormat="Hashed"
             maxInvalidPasswordAttempts="5"
             passwordAttemptWindow="10"
             minRequiredPasswordLength="7"
             minRequiredNonalphanumericCharacters="1" />
      </providers>
    </membership>

    <roleManager enabled="true" defaultProvider="ClinicSqlRoleProvider" cacheRolesInCookie="false">
      <providers>
        <clear />
        <add name="ClinicSqlRoleProvider"
             type="System.Web.Security.SqlRoleProvider"
             connectionStringName="ClinicDBConnection"
             applicationName="/ClinicCare" />
      </providers>
    </roleManager>

    <profile enabled="false" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>

  <!-- ======================================================================
       Authorization rules.

       The site denies anonymous users by default (see <system.web> above);
       these blocks re-open the pages that must stay public.

       NOTE: in the IIS integrated pipeline the URL authorization module also
       runs for static files, so without the Assets exception below anonymous
       visitors get an unstyled login page - the CSS and JS are blocked too,
       and the browser shows a sign-in popup for them.

       If the deployed site ever redirects EVERY page to Login.aspx, including
       Login.aspx itself, the cause is not these rules: check that Anonymous
       Authentication is enabled for the site in IIS. A response carrying
       WWW-Authenticate: Basic comes from IIS, never from forms authentication.
       ====================================================================== -->

  <location path="Assets">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>

  <location path="Default.aspx">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>

  <location path="Doctors.aspx">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>

  <location path="Login.aspx">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>

  <location path="Register.aspx">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>

  <!-- Booking and appointment lookup require a signed-in user. -->
  <location path="BookAppointment.aspx">
    <system.web>
      <authorization><deny users="?" /></authorization>
    </system.web>
  </location>

  <location path="MyAppointments.aspx">
    <system.web>
      <authorization><deny users="?" /></authorization>
    </system.web>
  </location>

  <!-- The whole admin area is restricted to the Admin role. -->
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

</configuration>
