<?xml version="1.0" encoding="utf-8"?>
<!--
  ClinicCare - Web.Release.config

  Transform applied when publishing in Release configuration. Visual Studio and
  MSBuild merge this into Web.config to produce the deployed file; this file
  itself is never deployed.

  TODO BEFORE DEPLOYING TO SmarterASP.net
    1. Paste the connection string from the SmarterASP control panel below.
    2. Paste the Gmail address / App Password, or switch to the host's SMTP.
    3. The <smtp> section in the development Web.config is encrypted with the
       RSA provider and that key exists only on the development machine, so the
       deployed file must carry plain values and be re-encrypted on the server
       (or left plain if the host does not permit aspnet_regiis).
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <connectionStrings>
    <add name="ClinicDBConnection"
         connectionString="Data Source=sql6031.site4now.net;Initial Catalog=db_acd7de_cliniccare;User ID=db_acd7de_cliniccare_admin;Password=__REDACTED__;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>

  <!--
    The development Web.config has this section encrypted with the
    RsaProtectedConfigurationProvider. That RSA key container exists only on the
    development machine, so if the encrypted XML were published as-is the live
    site would fail on the first email with:
        "Failed to decrypt using provider 'RsaProtectedConfigurationProvider'."
    Replacing the whole <smtp> element here drops the ciphertext and ships
    readable settings instead. The password stays a placeholder so no live
    credential is ever part of the deployment package - fill it in on the
    server, then optionally re-encrypt there with aspnet_regiis.
  -->
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" from="mohammedalmarzooq06@gmail.com"
            xdt:Transform="Replace">
        <network host="smtp.gmail.com"
                 port="587"
                 enableSsl="true"
                 userName="mohammedalmarzooq06@gmail.com"
                 password="__REDACTED__"
                 defaultCredentials="false" />
      </smtp>
    </mailSettings>
  </system.net>

  <appSettings>
    <!-- On shared hosting the database runs on a different machine, so the web
         application cannot write to or list a local backup folder. Backups are
         taken from the hosting control panel instead. -->
    <add key="BackupFolder" value=""
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>

  <system.web>
    <!-- Never ship debug symbols or the debug pipeline. -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />

    <!-- Show the friendly error page to everyone, not just remote users, so a
         stack trace can never be exposed on the live site. -->
    <customErrors mode="On" defaultRedirect="~/Default.aspx"
                  xdt:Transform="SetAttributes" />
  </system.web>

</configuration>
