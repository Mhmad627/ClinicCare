<?xml version="1.0" encoding="utf-8"?>
<packages>
  <!--
    Export libraries (rubric ID 4). Versions are pinned to releases that ship a
    .NET Framework build, so no netstandard shim assemblies or binding
    redirects are needed.
      EPPlus 4.5.3.3  - last LGPL release; later 5.x versions are commercial.
      iTextSharp 5.5  - AGPL; acceptable for this academic project.
    Word export uses System.IO.Packaging from the .NET Framework itself, so it
    has no package here.
  -->
  <package id="EPPlus" version="4.5.3.3" targetFramework="net48" />
  <package id="iTextSharp" version="5.5.13.4" targetFramework="net48" />
  <package id="BouncyCastle.Cryptography" version="2.4.0" targetFramework="net48" />
</packages>
