<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="ClinicCare.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> - ClinicCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="<%: ResolveUrl("~/Assets/css/site.css") %>" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <form id="frmMain" runat="server">

        <!-- ================= Navigation (rubric ID 2 - working navigation) ================= -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" href="<%: ResolveUrl("~/Default.aspx") %>">
                    <i class="bi bi-hospital me-1"></i>ClinicCare
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link <%= NavClass("Default") %>" href="<%: ResolveUrl("~/Default.aspx") %>">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= NavClass("BookAppointment") %>" href="<%: ResolveUrl("~/BookAppointment.aspx") %>">Book Appointment</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= NavClass("MyAppointments") %>" href="<%: ResolveUrl("~/MyAppointments.aspx") %>">My Appointments</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= NavClass("Doctors") %>" href="<%: ResolveUrl("~/Doctors.aspx") %>">Doctors</a>
                        </li>
                        <!-- The Admin menu is rendered only for users in the Admin role.
                             Hiding it is cosmetic - the Web.config <location> rule is
                             what actually enforces access. -->
                        <asp:PlaceHolder ID="phAdminMenu" runat="server" Visible="false">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle <%= NavClass("Admin") %>" href="#" id="navAdmin"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navAdmin">
                                    <li><a class="dropdown-item" href="<%: ResolveUrl("~/Admin/Dashboard.aspx") %>">Dashboard</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="<%: ResolveUrl("~/Admin/ManagePatients.aspx") %>">Manage Patients</a></li>
                                    <li><a class="dropdown-item" href="<%: ResolveUrl("~/Admin/ManageDoctors.aspx") %>">Manage Doctors</a></li>
                                    <li><a class="dropdown-item" href="<%: ResolveUrl("~/Admin/ManageAppointments.aspx") %>">Manage Appointments</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" href="<%: ResolveUrl("~/Admin/Backup.aspx") %>">Database Backup</a></li>
                                </ul>
                            </li>
                        </asp:PlaceHolder>
                    </ul>

                    <!-- ================= Account area ================= -->
                    <ul class="navbar-nav ms-3 mb-2 mb-lg-0">

                        <asp:PlaceHolder ID="phAnonymous" runat="server">
                            <li class="nav-item">
                                <a class="nav-link" href="<%: ResolveUrl("~/Login.aspx") %>">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Sign in
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="<%: ResolveUrl("~/Register.aspx") %>">Register</a>
                            </li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phAuthenticated" runat="server" Visible="false">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navAccount"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i><asp:Literal ID="litUserName" runat="server" />
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navAccount">
                                    <li>
                                        <span class="dropdown-item-text small text-muted">
                                            Role: <asp:Literal ID="litUserRoles" runat="server" />
                                        </span>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <asp:LinkButton ID="lnkSignOut" runat="server" CssClass="dropdown-item"
                                            OnClick="lnkSignOut_Click" CausesValidation="false">
                                            <i class="bi bi-box-arrow-right me-1"></i>Sign out
                                        </asp:LinkButton>
                                    </li>
                                </ul>
                            </li>
                        </asp:PlaceHolder>

                    </ul>
                </div>
            </div>
        </nav>

        <!-- ================= Page content ================= -->
        <main class="container py-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <!-- ================= Footer ================= -->
        <footer class="bg-light border-top mt-5 py-4">
            <div class="container text-center text-muted small">
                <div><strong><asp:Literal ID="litClinicName" runat="server" /></strong></div>
                <div>Reception: <asp:Literal ID="litClinicPhone" runat="server" /></div>
                <div class="mt-2">&copy; <asp:Literal ID="litYear" runat="server" /> ClinicCare &mdash; COOP Training Project</div>
            </div>
        </footer>

    </form>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="<%: ResolveUrl("~/Assets/js/site.js") %>"></script>
</body>
</html>
