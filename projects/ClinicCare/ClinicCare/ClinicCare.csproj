    <!-- WindowsBase supplies System.IO.Packaging, used to build the .docx export. -->
    <Reference Include="WindowsBase" />
    <!-- Simple assembly names + HintPath. Spelling out the full fusion name is
         fragile here: the BouncyCastle package is versioned 2.4.0 but its
         assembly version is 2.0.0.0, and a mismatched name makes MSBuild drop
         the reference silently instead of failing the build - which surfaces
         later as a FileNotFoundException at runtime. -->
    <Reference Include="EPPlus">
      <HintPath>..\packages\EPPlus.4.5.3.3\lib\net40\EPPlus.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="itextsharp">
      <HintPath>..\packages\iTextSharp.5.5.13.4\lib\net461\itextsharp.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <!-- iTextSharp calls into BouncyCastle when it creates the PDF document ID,
         so this is required at runtime even though no code references it. -->
    <Reference Include="BouncyCastle.Cryptography">
      <HintPath>..\packages\BouncyCastle.Cryptography.2.4.0\lib\net461\BouncyCastle.Cryptography.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
